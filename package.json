{
  "name": "px",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic pixel-art engine for AI agents",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "px": "./dist/cli.js",
    "px-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "setup": "pnpm install",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "rubric:report": "node scripts/rubric-report.mjs",
    "rubric:calibrate": "node scripts/calibrate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
